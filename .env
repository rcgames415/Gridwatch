# Copy to .env or set these values in your deployment environment.
PORT=3000
HOST=0.0.0.0
DATABASE_PATH=./data/gridwatch.sqlite
GRIDWATCH_ADMIN_TOKEN=TUFGaming

# Automatic refresh checks daily at this hour in Asia/Manila and retries
# throughout the current month until a reviewed rate is found.
INGEST_ENABLED=true
INGEST_HOUR_MANILA=08
INGEST_REQUEST_TIMEOUT_MS=18000
INGEST_USER_AGENT=GridwatchRateMonitor/1.0 (+public-rate-monitor)

# Structured SmartEnergyPH table rows can be auto-published as third-party leads.
# Set this false to send every finding to the administrator review queue instead.
INGEST_AUTO_PUBLISH_THIRD_PARTY=true
INGEST_AUTO_PUBLISH_CONFIDENCE=0.95
