{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "functions": {
    "api/[...path].js": {
      "maxDuration": 300,
      "includeFiles": "{migrations,seed}/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/refresh",
      "schedule": "0 0 * * *"
    }
  ]
}
